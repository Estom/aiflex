# PStock SDK Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Data Directory
DATA_DIR=./.pstock

# OpenAI / LLM Configuration
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# RagFlow Knowledge Base Integration (Optional)
# RAGFLOW_BASE_URL=http://ragflow.example.com:80
# RAGFLOW_API_KEY=ragflow-...

# BoCha Web Search API (Optional)
# BOCHA_API_KEY=your-bocha-api-key

# JWT Secret (for authentication)
JWT_SECRET=test_pwd_secret

# MCP Servers Configuration
# MCP servers are configured via JSON files in .pstock/mcp/*.json
