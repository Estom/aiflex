# PStock SDK Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Data Directory
DATA_DIR=./.pstock

# OpenAI / LLM Configuration

# 使用国内可访问的 API 镜像
OPENAI_API_KEY=your-real-api-key-here
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 或者使用通义千问（推荐）
# OPENAI_API_KEY=your-qwen-api-key-here
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# 设置超时（秒）
OPENAI_TIMEOUT=300

# RagFlow Knowledge Base Integration (Optional)
# RAGFLOW_BASE_URL=http://ragflow.example.com:80
# RAGFLOW_API_KEY=ragflow-...

# BoCha Web Search API (Optional)
# BOCHA_API_KEY=your-bocha-api-key

# JWT Secret (for authentication)
JWT_SECRET=test_pwd_secret

# MCP Servers Configuration
# MCP servers are configured via JSON files in .pstock/mcp/*.json
